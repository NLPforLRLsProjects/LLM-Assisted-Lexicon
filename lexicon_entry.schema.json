{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOUR-USERNAME/sotho-tswana-sentiment-lexicons/schemas/lexicon_entry.schema.json",
  "title": "Validated Sentiment Lexicon Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "word",
    "language",
    "english_gloss",
    "polarity",
    "intensity",
    "human_validation_status"
  ],
  "properties": {
    "word": {"type": "string", "minLength": 1},
    "language": {"enum": ["Sepedi", "Sesotho", "Setswana"]},
    "english_gloss": {"type": "string", "minLength": 1},
    "polarity": {
      "enum": ["positive", "negative", "neutral", "context_dependent"]
    },
    "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
    "contextual_consistency": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "human_validation_status": {
      "enum": ["validated", "revised", "rejected", "not_reviewed"]
    },
    "annotator_agreement": {"type": ["number", "null"]},
    "generation_model": {"type": ["string", "null"]},
    "generation_stage": {"type": ["string", "null"]},
    "batch_id": {"type": ["string", "null"]}
  }
}

